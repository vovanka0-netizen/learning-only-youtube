{
  "manifest_version": 3,
  "name": "Learning Only for YouTube",
  "version": "1.0.0",
  "description": "Hides recommended YouTube videos unless their category is Education, Science & Technology or Howto & Style.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "learning-only-youtube@vovanka0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
